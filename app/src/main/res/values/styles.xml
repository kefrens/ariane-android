<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Base application theme: Material 3 dark on every API level, with Ariane's
        colour roles. values-v29 adds the API 29+ window tweaks on top of it.
    -->
    <style name="Base.AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/ariane_primary</item>
        <item name="colorOnPrimary">@color/ariane_on_primary</item>
        <item name="colorPrimaryContainer">@color/ariane_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/ariane_on_primary_container</item>
        <item name="colorSecondary">@color/ariane_secondary</item>
        <item name="colorOnSecondary">@color/ariane_on_secondary</item>
        <item name="colorSecondaryContainer">@color/ariane_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/ariane_on_secondary_container</item>
        <item name="colorTertiary">@color/ariane_tertiary</item>
        <item name="colorOnTertiary">@color/ariane_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/ariane_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/ariane_on_tertiary_container</item>
        <item name="colorError">@color/ariane_error</item>
        <item name="colorOnError">@color/ariane_on_error</item>
        <item name="colorErrorContainer">@color/ariane_error_container</item>
        <item name="colorOnErrorContainer">@color/ariane_on_error_container</item>
        <item name="android:colorBackground">@color/ariane_background</item>
        <item name="colorOnBackground">@color/ariane_on_background</item>
        <item name="colorSurface">@color/ariane_surface</item>
        <item name="colorOnSurface">@color/ariane_on_surface</item>
        <item name="colorSurfaceVariant">@color/ariane_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/ariane_on_surface_variant</item>
        <item name="colorSurfaceContainerLow">@color/ariane_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/ariane_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/ariane_surface_container_high</item>
        <item name="colorOutline">@color/ariane_outline</item>
        <item name="colorOutlineVariant">@color/ariane_outline_variant</item>
    </style>

    <style name="AppBaseTheme" parent="Base.AppTheme" />

    <!-- Application theme. -->
    <style name="AppTheme" parent="AppBaseTheme">
        <!-- All customizations that are NOT specific to a particular API-level can go here. -->
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/ariane_background</item>
        <item name="android:navigationBarColor">@color/ariane_background</item>
        <item name="android:windowBackground">@color/ariane_background</item>
    </style>

    <style name="StreamBaseTheme" parent="AppBaseTheme">
        <!-- Transparent streaming background to avoid extra overdraw -->
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- Stream activity theme -->
    <style name="StreamTheme" parent="StreamBaseTheme">
        <!-- All customizations that are NOT specific to a particular API-level can go here. -->
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <!-- Added for API 34+ where ImageButton requires these color attrs to inflate -->
        <item name="android:colorControlNormal">@android:color/white</item>
        <item name="android:colorControlHighlight">@android:color/white</item>
        <item name="android:colorAccent">@android:color/white</item>
        <item name="android:colorControlActivated">@android:color/white</item>
        <item name="android:colorButtonNormal">@android:color/white</item>
        <!-- Duplicate non-prefixed color attributes for AppCompat widgets -->
        <item name="colorControlNormal">@android:color/white</item>
        <item name="colorControlHighlight">@android:color/white</item>
        <item name="colorAccent">@android:color/white</item>
        <item name="colorControlActivated">@android:color/white</item>
        <item name="colorButtonNormal">@android:color/white</item>
    </style>

    <!-- Settings screens share the app theme on every API level -->
    <style name="SettingsTheme" parent="AppTheme">
        <item name="preferenceTheme">@style/Ariane.PreferenceThemeOverlay</item>
    </style>

    <!-- Side panel that slides in from the right (setting choices on TV) -->
    <style name="Ariane.SidePanel" parent="AppTheme">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowAnimationStyle">@style/Ariane.SidePanelAnimation</item>
    </style>

    <style name="Ariane.SidePanelAnimation" parent="@android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/side_panel_in</item>
        <item name="android:windowExitAnimation">@anim/side_panel_out</item>
    </style>

    <!-- On/off settings show a switch instead of a checkbox -->
    <style name="Ariane.PreferenceThemeOverlay" parent="PreferenceThemeOverlay">
        <item name="checkBoxPreferenceStyle">@style/Ariane.Preference.Switch</item>
    </style>

    <style name="Ariane.Preference.Switch" parent="Preference.CheckBoxPreference.Material">
        <item name="android:widgetLayout">@layout/preference_widget_switch</item>
    </style>

    <style name="ExternalDisplayControllerTheme" parent="AppTheme">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <declare-styleable name="ApertureViewGroup">
        <attr name="aperture_color1" format="color" />
        <attr name="aperture_color2" format="color" />
        <attr name="aperture_border_width" format="dimension" />
        <attr name="aperture_border_angle" format="dimension" />
        <attr name="aperture_duration" format="integer" />
        <attr name="aperture_middle_color" format="color" />
    </declare-styleable>

</resources>
