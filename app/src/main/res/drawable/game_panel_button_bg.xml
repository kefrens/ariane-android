<?xml version="1.0" encoding="utf-8"?>
<!-- Disconnect button at the foot of the in-game panel -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/ariane_on_surface" />
            <stroke android:width="@dimen/focus_ring_width" android:color="@color/focus_ring" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/ariane_surface_container_high" />
        </shape>
    </item>
</selector>
