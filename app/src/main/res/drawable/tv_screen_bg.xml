<?xml version="1.0" encoding="utf-8"?>
<!-- Ambient screen background: a cool glow from the top left and a warm one from the
     bottom right over the dark base, in the spirit of the PS5 home screen -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="@color/ariane_background" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#8000497D"
                android:centerColor="#1A00497D"
                android:endColor="#0000497D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#4D743500"
                android:centerColor="#00743500"
                android:endColor="#00743500" />
        </shape>
    </item>
</layer-list>
