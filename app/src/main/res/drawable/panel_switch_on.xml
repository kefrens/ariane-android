<?xml version="1.0" encoding="utf-8"?>
<!-- A switch drawn in the "on" position, for toggle rows in the in-game panel -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="44dp" android:height="26dp" />
            <corners android:radius="13dp" />
            <solid android:color="@color/ariane_primary" />
        </shape>
    </item>
    <item android:left="22dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/ariane_on_primary" />
        </shape>
    </item>
</layer-list>
