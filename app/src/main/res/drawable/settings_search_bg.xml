<?xml version="1.0" encoding="utf-8"?>
<!-- Settings search field: a filled pill, with the white focus ring like the categories -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="@color/ariane_secondary_container" />
            <stroke android:width="@dimen/focus_ring_width" android:color="@color/focus_ring" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="@color/ariane_surface_container_high" />
        </shape>
    </item>
</selector>
