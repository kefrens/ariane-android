<?xml version="1.0" encoding="utf-8"?>
<!-- Section chip: primary container for the section at the top of the options -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/ariane_secondary_container" />
            <stroke android:width="@dimen/focus_ring_width" android:color="@color/focus_ring" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/ariane_primary_container" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/ariane_surface_container_high" />
        </shape>
    </item>
</selector>
