<?xml version="1.0" encoding="utf-8"?>
<!-- Quit session button: red, so it never looks like Disconnect -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/ariane_error_container" />
            <stroke android:width="@dimen/focus_ring_width" android:color="@color/focus_ring" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/ariane_error_container" />
        </shape>
    </item>
</selector>
