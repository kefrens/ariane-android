<?xml version="1.0" encoding="utf-8"?>
<!-- Side panel for a slider setting: the value in large type, a slider driven with Left and Right, then Save -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/side_panel_bg"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingRight="48dp"
    android:paddingTop="32dp"
    android:paddingBottom="27dp">

    <TextView
        android:id="@+id/seekPanelTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="20dp"
        android:paddingStart="20dp"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/seekPanelMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingLeft="20dp"
        android:paddingStart="20dp"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/seekPanelValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:textColor="@color/ariane_primary"
        android:textSize="44sp"
        android:textStyle="bold" />

    <SeekBar
        android:id="@+id/seekPanelBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/settings_category_bg"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:progressBackgroundTint="@color/ariane_outline"
        android:progressTint="@color/ariane_primary"
        android:thumbTint="@color/ariane_primary" />

    <TextView
        android:id="@+id/seekPanelHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/seek_panel_hint"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="15sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingStart="12dp">

        <TextView
            android:id="@+id/seekPanelSave"
            style="@style/Ariane.PanelButton"
            android:text="@string/seek_panel_save" />

        <TextView
            android:id="@+id/seekPanelCancel"
            style="@style/Ariane.PanelButton"
            android:layout_marginLeft="12dp"
            android:layout_marginStart="12dp"
            android:text="@string/cancel" />
    </LinearLayout>
</LinearLayout>
