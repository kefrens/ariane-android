<?xml version="1.0" encoding="utf-8"?>
<!-- Apps: host name on top, a "Running now" banner when a game is running, then the posters -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="24dp"
    android:paddingRight="24dp"
    android:paddingTop="16dp"
    tools:context=".AppView">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:preferKeepClear="true">

        <TextView
            android:id="@+id/appListText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/profilesButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/profile_manager_choose_profile"
            android:foreground="@drawable/focus_ring"
            app:elevation="0dp"
            app:icon="@drawable/ic_profiles" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/runningBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:layout_marginTop="16dp"
        android:background="@drawable/tv_banner_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="24dp"
        android:paddingRight="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/applist_running_now"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:textColor="@color/ariane_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/runningAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/runningResume"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:foreground="@drawable/focus_ring"
            android:text="@string/applist_resume"
            android:textSize="17sp"
            app:icon="@drawable/ic_play"
            app:iconSize="22dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/runningQuit"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginLeft="12dp"
            android:layout_marginStart="12dp"
            android:foreground="@drawable/focus_ring"
            android:text="@string/applist_quit"
            android:textSize="17sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/allAppsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/runningBanner"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/applist_all_apps"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="20sp" />

    <FrameLayout
        android:id="@+id/appFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/allAppsLabel"
        android:layout_alignParentBottom="true" />

</RelativeLayout>
