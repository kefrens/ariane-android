<?xml version="1.0" encoding="utf-8"?>
<!-- Apps: host name on top, a "Running now" banner when a game is running, then the posters -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?android:attr/colorBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="24dp"
    android:paddingRight="24dp"
    android:paddingTop="16dp"
    tools:context=".AppView">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:preferKeepClear="true">

        <TextView
            android:id="@+id/appListText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/profilesButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/profile_manager_choose_profile"
            android:foreground="@drawable/focus_ring"
            app:elevation="0dp"
            app:icon="@drawable/ic_profiles" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/runningBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:layout_marginTop="24dp"
        android:background="@drawable/tv_banner_bg"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/applist_running_now"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:textColor="@color/ariane_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/runningAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/runningResume"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:foreground="@drawable/focus_ring"
                android:text="@string/applist_resume"
                android:textSize="18sp"
                app:icon="@drawable/ic_play"
                app:iconSize="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/runningQuit"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginLeft="16dp"
                android:layout_marginStart="16dp"
                android:foreground="@drawable/focus_ring"
                android:text="@string/applist_quit"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/allAppsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/runningBanner"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        android:text="@string/applist_all_apps"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="20sp" />

    <FrameLayout
        android:id="@+id/appFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/allAppsLabel"
        android:layout_alignParentBottom="true" />

</RelativeLayout>
